flowchart TD
    A["Say: wake up LYA"] --> B["Offline Vosk wake detection"]
    B --> C["Native PySide6 orb appears"]
    C --> D["Visible camera indicator and one-frame capture"]
    D --> E["Local InsightFace embedding and match"]
    E --> F{"Known with sufficient confidence?"}
    F -- "Admin" --> G["Admin session and admin namespace"]
    F -- "Family or friend" --> H["Named session and that person's namespace"]
    F -- "No or uncertain" --> I["Guest session: no private data"]
    I --> J["Encrypted bounded pending thumbnail; expires in 7 days"]
    J --> K["Next admin session reviews thumbnail"]
    K --> L{"Admin decision"}
    L -- "Label" --> M["Create person id, name and role"]
    L -- "Delete or ignore" --> N["Delete or allow expiry"]
    M --> H

    G --> O["Encrypted local SQLite data scoped by person id"]
    H --> O
    O --> P["Local encrypted Important Vault"]
    P --> Q{"Marked available on phone?"}
    Q -- "No" --> R["Laptop only"]
    Q -- "Yes and connection exists" --> S["End-to-end encrypted sync"]
    S --> T["Encrypted iPhone cache"]
    T --> U["Cached important files work offline"]
    Q -- "Phone far away and no connection" --> V["Cannot fetch uncached data"]

    classDef local fill:#166534,color:#fff
    classDef decision fill:#1d4ed8,color:#fff
    classDef private fill:#6d28d9,color:#fff
    classDef limit fill:#991b1b,color:#fff
    class A,B,C,D,E,G,H,I local
    class F,L,Q decision
    class J,K,M,N,O,P,S,T,U private
    class R,V limit
